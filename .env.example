# ------------------------------------------------------------------------------
# Student Registry Environment Configuration (.env.example)
# Replace placeholders with your actual deployment values.
# NEVER commit real secret credentials or .env to version control.
# ------------------------------------------------------------------------------

# Database Client (Server-only)
# PostgreSQL connection URI (e.g. Supabase session-pooler or direct connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage & Administration (Server-only)
# Supabase project URL (read by server storage client)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase secret service role key (strictly server-only, never expose to browser)
SUPABASE_SECRET_KEY="your-supabase-secret-service-role-key"

# Private Supabase Storage bucket for coursework submissions (Server-only, default: sms)
SUPABASE_STORAGE_BUCKET="sms"

# Browser Upload / Public Supabase Configuration (Optional / Browser-accessible)
# The browser upload flow uses server-issued signed upload URLs, so no secret key
# is required on the client. If client-side Supabase features are enabled:
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
